# 复制成 .env 后按需修改。.env 不进 Git。
NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# MySQL。用户名/密码与 tools/init-db.sql 里建的一致
DATABASE_URL="mysql://fighting:fighting_dev_2026@127.0.0.1:3306/fighting"
DATABASE_POOL_SIZE=10

# HS256 签名密钥，至少 32 字符。生成方式：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-random-48-byte-string-at-least-32-chars"

# access token 15 分钟 / refresh token 7 天 / 轮换宽限 5 秒
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
REFRESH_GRACE_SEC=5

# 允许的前端来源，逗号分隔
CORS_ORIGIN=http://127.0.0.1:5173

# 生产必须 true（refresh cookie 带 Secure）
COOKIE_SECURE=false

# 游客记录保留天数
GUEST_TTL_DAYS=30
